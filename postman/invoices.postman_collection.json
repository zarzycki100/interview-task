{
  "info": {
    "name": "Invoices API",
    "description": "Main flow and error cases of the invoice API. Run the folders in order: the error cases reuse the invoice created by the main flow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Main flow",
      "item": [
        {
          "name": "Create invoice",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created with a Location header\", () => {",
                  "    pm.response.to.have.status(201);",
                  "    pm.response.to.have.header(\"Location\");",
                  "});",
                  "const invoice = pm.response.json();",
                  "pm.test(\"created as a draft with computed totals\", () => {",
                  "    pm.expect(invoice.status).to.eql(\"draft\");",
                  "    pm.expect(invoice.product_lines[0].total_unit_price).to.eql(30000);",
                  "    pm.expect(invoice.total_price).to.eql(30500);",
                  "});",
                  "pm.collectionVariables.set(\"invoiceId\", invoice.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/invoices",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "invoices"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_name\": \"Jane Doe\",\n  \"customer_email\": \"jane@example.com\",\n  \"product_lines\": [\n    {\n      \"name\": \"Consulting\",\n      \"quantity\": 2,\n      \"unit_price\": 15000\n    },\n    {\n      \"name\": \"Licence\",\n      \"quantity\": 1,\n      \"unit_price\": 500\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Show invoice",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"same invoice, still a draft\", () => {",
                  "    const invoice = pm.response.json();",
                  "    pm.expect(invoice.id).to.eql(pm.collectionVariables.get(\"invoiceId\"));",
                  "    pm.expect(invoice.status).to.eql(\"draft\");",
                  "    pm.expect(invoice.product_lines.map(line => line.name)).to.eql([\"Consulting\", \"Licence\"]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "invoices",
                "{{invoiceId}}"
              ]
            }
          }
        },
        {
          "name": "Send invoice",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"202 Accepted\", () => pm.response.to.have.status(202));",
                  "pm.test(\"invoice is now sending\", () => pm.expect(pm.response.json().status).to.eql(\"sending\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}/send",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "invoices",
                "{{invoiceId}}",
                "send"
              ]
            }
          }
        },
        {
          "name": "Simulate delivery confirmation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"204 No Content\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/notification/hook/delivered/{{invoiceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "notification",
                "hook",
                "delivered",
                "{{invoiceId}}"
              ]
            },
            "description": "What the e-mail provider would call after delivering the e-mail. The supplied dummy driver never calls it."
          }
        },
        {
          "name": "Show delivered invoice",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"invoice is sent-to-client\", () => pm.expect(pm.response.json().status).to.eql(\"sent-to-client\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "invoices",
                "{{invoiceId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Error cases",
      "item": [
        {
          "name": "Create invoice with invalid data",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"422 Unprocessable Content\", () => pm.response.to.have.status(422));",
                  "pm.test(\"each invalid field is reported\", () => {",
                  "    const errors = pm.response.json().errors;",
                  "    pm.expect(errors).to.have.property(\"customer_email\");",
                  "    pm.expect(errors).to.have.property(\"product_lines.0.quantity\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/invoices",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "invoices"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_name\": \"Jane Doe\",\n  \"customer_email\": \"not-an-email\",\n  \"product_lines\": [\n    {\n      \"name\": \"Consulting\",\n      \"quantity\": 0,\n      \"unit_price\": 15000\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create invoice without lines",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"draft with total 0\", () => {",
                  "    pm.expect(pm.response.json().status).to.eql(\"draft\");",
                  "    pm.expect(pm.response.json().total_price).to.eql(0);",
                  "});",
                  "pm.collectionVariables.set(\"emptyInvoiceId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/invoices",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "invoices"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_name\": \"Jane Doe\",\n  \"customer_email\": \"jane@example.com\",\n  \"product_lines\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Send invoice without lines",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"409 Conflict\", () => pm.response.to.have.status(409));",
                  "pm.test(\"code is invoice_has_no_lines\", () => pm.expect(pm.response.json().code).to.eql(\"invoice_has_no_lines\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{emptyInvoiceId}}/send",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "invoices",
                "{{emptyInvoiceId}}",
                "send"
              ]
            }
          }
        },
        {
          "name": "Send invoice that is not a draft",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"409 Conflict\", () => pm.response.to.have.status(409));",
                  "pm.test(\"code is invoice_not_draft\", () => pm.expect(pm.response.json().code).to.eql(\"invoice_not_draft\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}/send",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "invoices",
                "{{invoiceId}}",
                "send"
              ]
            },
            "description": "Reuses the invoice from the main flow, which is already sent-to-client."
          }
        },
        {
          "name": "Show unknown invoice",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"404 Not Found\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{$guid}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "invoices",
                "{{$guid}}"
              ]
            }
          }
        },
        {
          "name": "Delivery confirmation for unknown invoice",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"204, the same answer as for a known invoice\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/notification/hook/delivered/{{$guid}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "notification",
                "hook",
                "delivered",
                "{{$guid}}"
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost"
    },
    {
      "key": "invoiceId",
      "value": ""
    },
    {
      "key": "emptyInvoiceId",
      "value": ""
    }
  ]
}
